 Q11. Bank Wallet Transfer Using MongoDB Transactions

```javascript
use BankDB

db.Wallets.insertMany([
    {
        User_ID: 101,
        Name: "Yash Jain",
        Balance: 10000
    },
    {
        User_ID: 102,
        Name: "Rahul",
        Balance: 5000
    }
])

db.Wallets.find()

const session = db.getMongo().startSession()

const bankDB = session.getDatabase("BankDB")

session.startTransaction()

try {
    const sender = bankDB.Wallets.updateOne(
        {
            User_ID: 101,
            Balance: {$gte: 2000}
        },
        {
            $inc: {Balance: -2000}
        }
    )

    if (sender.matchedCount !== 1) {
        throw new Error("Insufficient balance or sender not found")
    }

    const receiver = bankDB.Wallets.updateOne(
        {User_ID: 102},
        {
            $inc: {Balance: 2000}
        }
    )

    if (receiver.matchedCount !== 1) {
        throw new Error("Receiver not found")
    }

    session.commitTransaction()
    print("Transaction Successful")

} catch (error) {
    session.abortTransaction()
    print("Transaction Failed: " + error.message)

} finally {
    session.endSession()
}

db.Wallets.find()
```

