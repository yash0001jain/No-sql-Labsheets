 Q24. Compare MongoDB with SQL

 SQL INSERT
 INSERT INTO Students VALUES
 (301, 'Aman', 'BCA', 5, 8.5);

 MongoDB INSERT
db.Students.insertOne({
    RollNo: 301,
    Name: "Aman",
    Department: "BCA",
    Semester: 5,
    CGPA: 8.5
})

 SQL SELECT
 SELECT * FROM Students;

 MongoDB SELECT
db.Students.find()

 SQL UPDATE
 UPDATE Students SET Department='MCA'
 WHERE RollNo=301;

 MongoDB UPDATE
db.Students.updateOne(
    { RollNo: 301 },
    {
        $set: {
            Department: "MCA"
        }
    }
)

SQL DELETE
DELETE FROM Students WHERE RollNo=301;

 MongoDB DELETE
db.Students.deleteOne({
    RollNo: 301
})


