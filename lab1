    }
)


Q12. Add Email field to all students

db.Students.updateMany(
    {},
    {
        $set: {
            Email: "student@example.com"
        }
    }
)


Q13. Remove Email field from all students

db.Students.updateMany(
    {},
    {
        $unset: {
            Email: ""
        }
    }
)


Q14. Delete a specific student

